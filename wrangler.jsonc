{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "portfolio-website",
    "main": "worker/index.ts",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Only the agent API runs code; every other request is a static file
        "run_worker_first": ["/api/*"],
    },
    "ai": { "binding": "AI" },
    "ratelimits": [
        {
            "name": "CHAT_LIMIT",
            "namespace_id": "1001",
            "simple": { "limit": 10, "period": 60 },
        },
        {
            "name": "MESSAGE_LIMIT",
            "namespace_id": "1002",
            "simple": { "limit": 2, "period": 60 },
        },
    ],
    // Visitor messages from agent.sh. Needs Email Routing on bbelbuken.com
    // with this address verified; it is the only one the Worker can mail
    "send_email": [
        { "name": "SEND_EMAIL", "destination_address": "bbelbuken@gmail.com" },
    ],
    "observability": { "enabled": true },
}
